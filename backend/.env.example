# --- Base de données : Supabase (PostgreSQL) ---
# Supabase → bouton « Connect » → « Session pooler » → copier l'URI et remplacer [YOUR-PASSWORD].
# Exemple : postgresql://postgres.abcdefgh:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
DATABASE_URL=
# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# --- Cloudinary (photos des salles et formations) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Serveur ---
PORT=4000
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=8h
# --- Connexion administrateur (aucun compte en base : tout vient d'ici) ---
ADMIN_FULL_NAME=Administrateur
ADMIN_EMAIL=
ADMIN_PASSWORD=
# URL(s) du frontend autorisées par CORS, séparées par des virgules (slash final toléré ; * = toutes les origines)
FRONTEND_URL=http://localhost:5173

# --- Connexion avec Google (facultative) ---
# console.cloud.google.com → API et services → Identifiants → ID client OAuth « Application Web ».
# Origines JavaScript autorisées : l'adresse de kim-web (et http://localhost:5173 en local). Vide = bouton Google masqué.
GOOGLE_CLIENT_ID=

# --- E-mails de compte : mot de passe oublié, vérification de l'adresse (API Resend, gratuit jusqu'à 3 000 e-mails/mois) ---
# Sans clé, aucun e-mail ne part : le lien est écrit dans les journaux du serveur.
MAIL_API_KEY=
MAIL_FROM=Kim CSCTICAO <no-reply@votre-domaine.ci>
# Adresse publique du site (liens des e-mails) ; par défaut, la première valeur de FRONTEND_URL
PUBLIC_SITE_URL=

# Mode évaluation (golden dataset / RAGAS) : laisser vide pour le désactiver (la route répond alors 404).
EVAL_API_KEY=
